// Meme environnement que ./start.sh : meme Dockerfile, memes montages, meme
// utilisateur `dev`, meme entrypoint (ESCAPEBOX_DEVCONTAINER le garde vivant au
// lieu de lancer claude). Les deux modes partagent ~/.claude (sessions, memoire)
// et ~/.claude-code-local, et peuvent tourner en meme temps.
{
  "name": "Blackbox ESP32",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "runArgs": ["--privileged"],
  "overrideCommand": false,
  "containerEnv": {
    "ESCAPEBOX_DEVCONTAINER": "1"
  },
  "initializeCommand": "mkdir -p \"$HOME/.claude\" \"$HOME/.claude-code-local\"",
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/tmp/ssh_host,type=bind,readonly",
    "source=${localEnv:HOME}/.claude,target=/home/dev/.claude,type=bind",
    "source=${localEnv:HOME}/.claude-code-local,target=/home/dev/.local,type=bind"
  ],
  "workspaceFolder": "/workspaces/blackbox",
  "remoteUser": "dev",
  "updateRemoteUserUID": false,
  "forwardPorts": [3000],
  "customizations": {
    "vscode": {
      "extensions": [
        "espressif.esp-idf-extension",
        "anthropic.claude-code"
      ]
    }
  }
}
